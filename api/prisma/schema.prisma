model Cita {
  id                  Int @id @default(autoincrement())
  fechaCita           DateTime 
  horaInicio          String @db.VarChar(50)
  horaFin             String @db.VarChar(50)

  modalidad           Modalidad  @default(PRESENCIAL)
  estado 	      EstadoCita @default(PENDIENTE)

  comentarioCliente   String @db.VarChar(200)
  comentarioTutor     String? @db.VarChar(255)

  montoEstimado       Decimal @default(0.00) @db.Decimal(10, 2)


  //clienteId           Int
  //tutorId             Int
  //servicioId          Int

  createAt DateTime @default(now())
  updateAt DateTime @default(now()) @updatedAt

  }

model Resena {
  id              Int @id @default(autoincrement())
  puntuacion      Int @default(0)
  comentario      String @db.VarChar(355)

  //citaId          Int
  //clienteId       Int
  //tutorId         Int


  createAt DateTime @default(now())
  updateAt DateTime @default(now()) @updatedAt
  
}
